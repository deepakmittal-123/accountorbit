<section class="section section--tight">
  <div class="wrap contact-grid">
    <div class="side-card side-card--dark contact-call">
      <h2>Call {{ site.owner.name }}</h2>
      <a class="btn btn--gold btn--wide contact-number" href="{{ site.phoneHref }}">{{ site.phoneDisplay }}</a>
      <p class="contact-small">You speak with Deepak directly, about a new requirement or a question. {% gap "the hours this number is answered, and an email address." %}</p>
    </div>
    <div>
      <h2 class="plain-h2">Which route fits?</h2>
      <section class="data-table-wrap" tabindex="0" aria-label="Contact routes, scrolls sideways on small screens">
        <table class="data-table">
          <thead><tr><th scope="col">If you want to</th><th scope="col">Do this</th></tr></thead>
          <tbody>
            <tr><th scope="row">Find accounting or tax help</th><td>Call {{ site.owner.name }}, with <a href="/request-an-accountant/">the details listed on the requirements page</a> to hand</td></tr>
            <tr><th scope="row">Understand how an enquiry works</th><td>Read <a href="/how-it-works/">how it works</a></td></tr>
            <tr><th scope="row">Check an income tax notice</th><td>Use the {% ext "https://eportal.incometax.gov.in/iec/foservices/#/pre-login/authenticate-notice-issued-by-itd", "department's own notice check" %}, the official way to confirm a notice is genuine</td></tr>
            <tr><th scope="row">Find a practising CA directly</th><td>Search {% ext "https://caconnect.icai.org/search-your-ca", "ICAI CA Connect" %}</td></tr>
            <tr><th scope="row">Discuss an accounting or tax requirement</th><td>Call {{ site.owner.name }}, who discusses it with you and coordinates the next steps</td></tr>
            <tr><th scope="row">Correct, delete or ask about your details</th><td>See the <a href="/privacy-policy/">privacy policy</a>, or call</td></tr>
            <tr><th scope="row">Report a problem or complain</th><td>Call {{ site.phoneDisplay }} and say you are raising a complaint. {% gap "a named complaints route and response time." %}</td></tr>
          </tbody>
        </table>
      </section>
    </div>
  </div>
</section>

<section class="section section--tint" aria-labelledby="urgent-title">
  <div class="wrap two-col">
    <div>
      <h2 id="urgent-title">If you have a deadline</h2>
      <p>Tell Deepak the date at the start of the call. If a notice or filing date is very close, also check the options on the official portal concerned, and do not leave a reply until the last day.</p>
    </div>
    <div>
      <h2>Please do not send</h2>
      <ul class="tick-list tick-list--no plain-list">
        <li>Passwords or OTPs, to anyone who says they are calling from us</li>
        <li>PAN or Aadhaar scans, bank statements or tax filings</li>
      </ul>
    </div>
  </div>
</section>

<section class="section" aria-labelledby="where-title">
  <div class="wrap prose">
    <h2 id="where-title" class="plain-h2">Where we are</h2>
    <p>AccountOrbit works by phone and does not run a walk-in office, so please call rather than visit. {% gap "a complete, verified address and a decision on whether to show one. The supplied address stays unpublished until then." %}</p>
    <p>The owner's {% ext site.owner.facebook, "Facebook" %} and {% ext site.owner.instagram, "Instagram" %} are personal profiles, not AccountOrbit support channels.</p>
  </div>
</section>
