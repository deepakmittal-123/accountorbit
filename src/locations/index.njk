  <div class="wrap two-col">
    <div>
      <h2 id="near-title">When location does matter</h2>
      <ul class="tick-list plain-list">
        <li>Your bills and registers are on paper at your premises</li>
        <li>Stock must be counted or observed on site</li>
        <li>You want someone to visit on fixed days</li>
        <li>You prefer to meet in person</li>
      </ul>
    </div>
    <div>
      <h2>When it matters less</h2>
      <ul class="tick-list plain-list">
        <li>You already keep records digitally</li>
        <li>Your filings are done through online portals</li>
        <li>You need particular experience more than proximity</li>
        <li>You are comfortable sharing documents by a secure method</li>
      </ul>
    </div>
  </div>
</section>

