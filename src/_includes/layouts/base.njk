{%- set route = page.url | routeOf -%}
{%- set primaryNav = site.nav | navItems -%}
{%- set legalNav = site.footerLegal | navItems -%}
{%- set exploreNav = site.footerExplore | navItems -%}
{%- set platformNav = site.footerPlatform | navItems -%}
{%- set ctaHref = '/request-an-accountant/' if ('/request-an-accountant/' | built) else '/#start' -%}
<!doctype html>
<html lang="en-IN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  <meta name="robots" content="{{ 'noindex, nofollow' if env.isPreview else ('index, follow' if route.indexable else 'noindex, follow') }}">
  {%- if route and not env.isPreview %}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  {%- endif %}
  <meta property="og:type" content="{{ 'article' if schemaType == 'Article' else 'website' }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:url" content="{{ env.publicOrigin }}{{ page.url }}">
  <meta property="og:locale" content="en_IN">
  <meta property="og:image" content="{{ env.publicOrigin }}/assets/og-image.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="AccountOrbit: find accounting help in Delhi, and know who is doing what. Independent referral platform, not a CA firm.">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="theme-color" content="#16392c">
  <link rel="icon" href="/favicon.ico" sizes="32x32 48x48">
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <link rel="preload" href="/assets/fonts/hanken-grotesk.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/site.css">
</head>
<body>
  <a class="skip-link" href="#main">Skip to main content</a>
  {% if not env.isProduction and not env.isPreview %}<aside class="draft-bar" aria-label="Development notice"><strong>Local development build.</strong>{% if not route.indexable %} This page is noindex.{% endif %}</aside>{% endif %}
  <header class="site-header">
    <div class="wrap site-header__row">
      <a class="site-logo" href="/"><img src="/assets/images/brand/accountorbit-logo-header.webp" alt="{{ site.name }}" width="540" height="120" fetchpriority="high"></a>
      <nav class="desktop-nav" aria-label="Main">
        {%- for item in primaryNav %}
        <a href="{{ item.href }}"{% if item.href == page.url %} aria-current="page"{% endif %}>{{ item.label }}</a>
        {%- endfor %}
      </nav>
      <a class="header-phone" href="{{ site.phoneHref }}">{{ site.phoneDisplay }}</a>
      <a class="btn btn--small" href="{{ ctaHref }}">Find an Accountant</a>
      <details class="site-menu">
        <summary>Menu</summary>
        <nav aria-label="Main, mobile">
          {%- for item in primaryNav %}
          <a href="{{ item.href }}"{% if item.href == page.url %} aria-current="page"{% endif %}>{{ item.label }}</a>
          {%- endfor %}
          <a href="{{ site.phoneHref }}">Call {{ site.phoneDisplay }}</a>
        </nav>
      </details>
    </div>
  </header>
  <main id="main">
    {{ content | safe }}
  </main>
  <footer class="site-footer">
    <div class="wrap site-footer__grid">
      <div>
        <p class="footer-logo"><img src="/assets/images/brand/accountorbit-logo-footer.webp" alt="" width="600" height="133" loading="lazy" decoding="async"></p>
        <p class="footer-disclosure">AccountOrbit is an independent referral platform. It is not a Chartered Accountant firm, law firm, audit practice, tax authority or government service, and it does not perform accounting, tax or legal work. Services, fees and terms are agreed directly with the professional you engage.</p>
      </div>
      <div>
        <p class="footer-title">Contact</p>
        <p><a href="{{ site.phoneHref }}">{{ site.phoneDisplay }}</a></p>
        <p class="footer-owner">Owner: <a href="/about-me/">{{ site.owner.name }}</a></p>
      </div>
      <div>
        <p class="footer-title">Explore</p>
        <ul class="footer-list">
          {%- for item in exploreNav %}
          <li><a href="{{ item.href }}">{{ item.label }}</a></li>
          {%- endfor %}
        </ul>
      </div>
      <div>
        <p class="footer-title">Platform</p>
        <ul class="footer-list">
          {%- for item in platformNav %}
          <li><a href="{{ item.href }}">{{ item.label }}</a></li>
          {%- endfor %}
          <li><a href="{{ ctaHref }}">Find an Accountant</a></li>
        </ul>
      </div>
      <div>
        <p class="footer-title">Legal</p>
        {%- if legalNav.length %}
        <ul class="footer-list">
          {%- for item in legalNav %}
          <li><a href="{{ item.href }}">{{ item.label }}</a></li>
          {%- endfor %}
        </ul>
        {%- endif %}
        {%- if legalNav.length < 3 %}
        <p>Questions about our policies? Call <a href="{{ site.phoneHref }}">{{ site.phoneDisplay }}</a>.</p>
        {%- endif %}
      </div>
    </div>
    <div class="wrap site-footer__base">
      <p>Guides are written from official sources, including the {% ext "https://www.gst.gov.in/", "GST" %}, {% ext "https://www.incometax.gov.in/", "Income Tax" %} and {% ext "https://udyamregistration.gov.in/", "Udyam" %} portals. Advice on your own situation comes from the qualified professional you engage. <a href="/disclaimer/">Disclaimer</a>.</p>
      <p>&copy; {{ site.name }}</p>
    </div>
  </footer>
  <script src="/assets/js/site.js" defer></script>
  {%- if extraJs %}
  <script src="{{ extraJs }}" defer></script>
  {%- endif %}
</body>
</html>
