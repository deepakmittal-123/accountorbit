{#- Desktop mega menu for one top-level item. Expects `m` (a resolved megaMenu) and `page`.
    The hub link always works; the chevron button is revealed by site.js, which opens the panel. -#}
<div class="mega{% if page.url.startsWith(m.hub) %} is-section{% endif %}" data-mega>
  <a class="mega__link" href="{{ m.hub }}"{% if page.url == m.hub %} aria-current="page"{% endif %}>{{ m.label }}</a>
  <button class="mega__toggle" type="button" aria-expanded="false" aria-controls="mega-{{ m.id }}" hidden>
    <span class="visually-hidden">{{ m.label }} pages</span>
    <svg viewBox="0 0 12 8" width="12" height="8" aria-hidden="true" focusable="false"><path d="M1.5 1.75 6 6.25l4.5-4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
  <div class="mega__panel mega__panel--{{ m.id }}" id="mega-{{ m.id }}" hidden>
    <div class="mega__cols mega__cols--{{ m.groups.length }}">
      {%- for g in m.groups %}
      <div class="mega__col">
        <p class="mega__title" id="mega-{{ m.id }}-{{ loop.index }}">
          {%- if g.hub %}<a href="{{ g.hub.url }}"{% if page.url == g.hub.url %} aria-current="page"{% endif %}>{{ g.title }}<span class="mega__go" aria-hidden="true">&rarr;</span></a>{% else %}{{ g.title }}{% endif -%}
        </p>
        <ul class="mega__list" aria-labelledby="mega-{{ m.id }}-{{ loop.index }}">
          {%- for i in g.items %}
          <li><a href="{{ i.url }}"{% if page.url == i.url %} aria-current="page"{% endif %}>{{ i.label }}</a></li>
          {%- endfor %}
        </ul>
        {%- if g.covered.length %}
        <p class="mega__covered">Also covered on the {{ g.title | lower }} page: {{ g.covered | join(", ") }}</p>
        {%- endif %}
      </div>
      {%- endfor %}
    </div>
    <p class="mega__foot"><a class="mega__all" href="{{ m.hub }}">{{ m.all }}<span aria-hidden="true"> &rarr;</span></a></p>
  </div>
</div>
