<section class="cta-band">
  <div class="wrap cta-band__inner">
    <div>
      <h2>{{ ctaTitle or 'Need help with this?' }}</h2>
      <p>{{ ctaText or 'Describe the work to AccountOrbit.' }} You speak with {{ site.owner.name }} directly on {{ site.phoneDisplay }}, and he coordinates the next steps.</p>
    </div>
    <div class="cta-band__actions">
      <a class="btn btn--gold" href="{{ site.phoneHref }}">Speak with {{ site.owner.name }}</a>
      <a class="btn btn--ghost" href="/request-an-accountant/">What to prepare</a>
    </div>
    <img class="cta-band__art" src="/assets/illustrations/band-enquiry.svg" alt="" width="420" height="300" loading="lazy">
  </div>
</section>
