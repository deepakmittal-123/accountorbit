{
  "name": "accountorbit",
  "version": "0.1.0",
  "private": true,
  "description": "AccountOrbit static website. See README.md.",
  "type": "module",
  "scripts": {
    "build": "eleventy",
    "build:production": "node scripts/build-production.mjs",
    "build:pages": "node scripts/build-pages-preview.mjs",
    "serve": "eleventy --serve",
    "qa": "node qa/site-qa.mjs",
    "qa:home": "node qa/homepage-qa.mjs",
    "qa:deep": "node qa/deep-qa.mjs",
    "qa:content": "node qa/content-audit.mjs",
    "qa:files": "node qa/seo-files-qa.mjs",
    "qa:pages": "node qa/pages-preview-check.mjs",
    "qa:pages:browser": "node qa/pages-browser-qa.mjs",
    "icons": "node scripts/make-icons.mjs",
    "illustrations": "node scripts/make-illustrations.mjs",
    "status": "node scripts/status-report.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.8",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "axe-core": "^4.14.0",
    "html-validate": "^11.18.0",
    "playwright-core": "^1.64.1"
  }
}
